    "schemas": {
      "DecideIn": {
        "properties": {
          "approve": {
            "type": "boolean",
            "title": "Approve"
          }
        },
        "type": "object",
        "required": [
          "approve"
        ],
        "title": "DecideIn"
      },
      "ExitIn": {
        "properties": {
          "staff_verdicts": {
            "additionalProperties": {
              "type": "boolean"
            },
            "type": "object",
            "title": "Staff Verdicts",
            "default": {}
          },
          "found": {
            "items": {
              "$ref": "#/components/schemas/LineIn"
            },
            "type": "array",
            "title": "Found",
            "default": []
          }
        },
        "type": "object",
        "title": "ExitIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LineIn": {
        "properties": {
          "line_id": {
            "type": "string",
            "title": "Line Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "sku": {
            "type": "string",
            "title": "Sku"
          },
          "price": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Price"
          },
          "p": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "P"
          },
          "evidence": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence"
          }
        },
        "type": "object",
        "required": [
          "line_id",
          "name",
          "sku",
          "price",
          "p"
        ],
        "title": "LineIn"
      },
      "NotMineIn": {
        "properties": {
          "footage_shows_take": {
            "type": "boolean",
            "title": "Footage Shows Take"
          }
        },
        "type": "object",
        "required": [
          "footage_shows_take"
        ],
        "title": "NotMineIn"
      },
      "OutcomeIn": {
        "properties": {
